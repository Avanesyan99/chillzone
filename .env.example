# ── Firebase ───────────────────────────────────────────────────────────────────
# Get from: console.firebase.google.com → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Get from: console.firebase.google.com → Project Settings → General → Web API Key
FIREBASE_WEB_API_KEY=

# ── Vercel Blob ────────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match exactly what you set in Google Console (Authorized redirect URIs)
NEXT_PUBLIC_APP_URL=

# ── Resend (email) ─────────────────────────────────────────────────────────────
# Get from: resend.com → API Keys → Create API Key
RESEND_API_KEY=
# Must be a verified domain in Resend, or use onboarding@resend.dev for testing
RESEND_FROM=
