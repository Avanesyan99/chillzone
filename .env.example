# ── Supabase Postgres ──────────────────────────────────────────────────────────
 # for testing without a verified domain
DATABASE_URL="postgresql://postgres.xxxxx:[PASSWORD]@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxxx:[PASSWORD]@aws-0-xx.pooler.supabase.com:5432/postgres"

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-string-32-chars-min"
ADMIN_KEY="change-this-admin-secret"

# ── Vercel Blob ────────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0
GOOGLE_CLIENT_ID="xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"
# Must match exactly what you set in Google Console (Authorized redirect URIs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Resend (email) ─────────────────────────────────────────────────────────────
# Get from: resend.com → API Keys → Create API Key
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Must be a verified domain in Resend, or use onboarding@resend.dev for testing
RESEND_FROM="CHILLZONE <noreply@tudominio.com> "
